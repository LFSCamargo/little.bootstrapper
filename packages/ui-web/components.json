{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "../../apps/web/src/app/globals.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@little-bootstrapper/ui-web/shadcn",
    "utils": "@little-bootstrapper/ui-web/lib/utils",
    "ui": "@little-bootstrapper/ui-web/shadcn",
    "lib": "@little-bootstrapper/ui-web/lib",
    "hooks": "@little-bootstrapper/ui-web/hooks"
  },
  "registries": {
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@aceternity-pro": {
      "url": "https://pro.aceternity.com/registry/{name}.json",
      "headers": {
        "Authorization": "Bearer ${ACETERNITY_PRO_API_KEY}",
        "X-License-Key": "${ACETERNITY_PRO_LICENSE_KEY}"
      }
    }
  }
}
