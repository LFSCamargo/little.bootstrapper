{
  "name": "@little-bootstrapper/ui-cli",
  "version": "1.0.0",
  "description": "Shared React Ink + @inkjs/ui Animated CLI Components (little.bootstrapper Terminal Design System)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "ink": "5.1.0",
    "ink-text-input": "6.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "18.3.18",
    "@vitest/coverage-v8": "3.1.1",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}
